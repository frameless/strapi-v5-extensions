{
  "name": "@frameless/catalogi-data",
  "version": "0.0.0",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "keywords": [
    "catalogi",
    "data",
    "gemeenten",
    "catalogus"
  ],
  "author": "Frameless",
  "description": "A Nodejs application that convert the catalogi XML to JSON formate",
  "license": "EUPL-1.2",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:frameless/strapi-v5-extensions.git",
    "directory": "packages/catalogi-data"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rimraf dist src/build",
    "generate": "ts-node src/generate.ts",
    "build": "npm run clean && npm run generate && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix"
  },
  "peerDependencies": {
    "xmlbuilder2": ">=3.0.2"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "xmlbuilder2": "4.0.3",
    "rimraf": "6.1.3",
    "tsup": "8.5.1",
    "@frameless/eslint-config": "workspace:*",
    "@frameless/typescript-config": "workspace:*"
  },
  "engines": {
    "node": ">=22.0.0 <25",
    "pnpm": ">=10.0.0"
  }
}
