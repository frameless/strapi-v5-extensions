{
  "name": "@frameless/strapi-plugin-notes",
  "version": "1.1.0",
  "description": "A plugin for Strapi CMS that provides the ability to add notes to entity records.",
  "strapi": {
    "displayName": "Notes",
    "description": "A plugin for Strapi Headless CMS that provides the ability to add notes to entity records.",
    "name": "entity-notes",
    "kind": "plugin"
  },
  "author": {
    "name": "Frameless"
  },
  "license": "EUPL-1.2",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.tsx",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:frameless/strapi-v5-extensions.git",
    "directory": "packages/strapi-plugin-notes"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.21",
    "dayjs": "1.11.21",
    "react-intl": "8.1.3"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.28.5",
    "@frameless/eslint-config": "workspace:*",
    "@frameless/typescript-config": "workspace:*",
    "@strapi/design-system": "2.1.2",
    "@strapi/icons": "2.1.2",
    "@strapi/sdk-plugin": "5.4.0",
    "@strapi/strapi": "5.46.0",
    "@strapi/typescript-utils": "5.46.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "29.5.12",
    "@types/node": "24.10.9",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/styled-components": "5.1.36",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "koa": "3.1.2",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@strapi/design-system": ">=2.0.0",
    "@strapi/icons": ">=2.0.0",
    "@strapi/strapi": ">=5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "lint-build": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.server.json",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "clean": "rimraf .next .strapi dist",
    "test": "jest --passWithNoTests"
  },
  "engines": {
    "node": ">=22.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "plugin",
    "strapi plugin",
    "notes"
  ]
}
