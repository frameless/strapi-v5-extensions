{
  "name": "@frameless/content-compliance-checker",
  "version": "1.0.3",
  "description": "A Strapi plugin that audits content blocks for compliance with category requirements. Specifically checks for blocks that don't have the 'kennisartikel' category assigned, helping maintain content standards across products.",
  "strapi": {
    "name": "content-compliance-checker",
    "description": "Dashboard for identifying content blocks that don't meet category requirements.",
    "kind": "plugin"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.tsx",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "keywords": [
    "strapi",
    "plugin",
    "content",
    "compliance",
    "checker",
    "kennisartikel",
    "category",
    "requirements",
    "dashboard",
    "block",
    "audit"
  ],
  "dependencies": {
    "@tanstack/react-query": "5.95.2",
    "@utrecht/component-library-css": "9.0.12",
    "@utrecht/component-library-react": "14.0.1",
    "@utrecht/design-tokens": "6.2.1",
    "is-absolute-url": "5.0.0",
    "react-icons": "5.6.0",
    "react-markdown": "10.1.0",
    "react-to-print": "3.3.0",
    "rehype-raw": "7.0.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "7.28.5",
    "@frameless/eslint-config": "workspace:*",
    "@frameless/typescript-config": "workspace:*",
    "@strapi/admin": "5.46.0",
    "@strapi/design-system": "2.1.2",
    "@strapi/icons": "2.1.2",
    "@strapi/sdk-plugin": "5.4.0",
    "@strapi/strapi": "5.46.0",
    "@strapi/typescript-utils": "5.46.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "29.5.12",
    "@types/lodash.kebabcase": "4.1.9",
    "@types/node": "24.10.9",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "koa": "3.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "rimraf": "6.1.3",
    "sass": "1.98.0",
    "styled-components": "6.3.12",
    "ts-jest": "29.2.6",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "peerDependencies": {
    "@strapi/design-system": ">=2.0.0",
    "@strapi/icons": ">=2.0.0",
    "@strapi/strapi": ">=5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:frameless/strapi-v5-extensions.git",
    "directory": "packages/strapi-plugin-flo-legal-embed"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "author": {
    "name": "Frameless"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "lint-build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test:ts:front": "run -T tsc -p tsconfig.json",
    "test:ts:back": "run -T tsc -p tsconfig.server.json",
    "clean": "rimraf .next .strapi dist"
  },
  "license": "EUPL-1.2"
}
